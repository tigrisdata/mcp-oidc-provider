# Public URL of this server. MCP clients connect to <BASE_URL>/mcp and the
# relay's OAuth endpoints live on the same origin.
BASE_URL=http://localhost:3000
PORT=3000

# Your identity provider (any OpenID Connect provider). Register a confidential
# web application there with <BASE_URL>/oauth/callback as the callback URL.
OIDC_ISSUER=https://your-tenant.auth0.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The API identifier (audience) the provider issues JWT access tokens for.
# Auth0: the identifier of an API you created; Okta: the audience of the
# custom authorization server; Keycloak: the client an audience mapper adds.
OIDC_AUDIENCE=https://api.example.com
